{
  "name": "sdis13-saison-feux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application web du projet SDIS 13 : récit, simulateur de seuil, carte et calendrier des feux",
  "scripts": {
    "donnees": "cd ../.. && uv run python -m pipeline.exporter_web",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-interpolate": "^3.0.2",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
